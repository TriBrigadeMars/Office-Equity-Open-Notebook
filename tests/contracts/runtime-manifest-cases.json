{
  "validManifests": [
    {
      "input": {
        "upstreamCommit": "a1b2c3d4e5f67890123456789012345678901234",
        "wrapperCommit": "1234567890abcdef1234567890abcdef12345678",
        "buildTimestamp": "2025-01-15T12:00:00.000Z",
        "targetArchitecture": "x64"
      },
      "expectedUpstreamCommit": "a1b2c3d4e5f67890123456789012345678901234"
    },
    {
      "input": "{\n  \"upstreamCommit\": \"deadbeef1234567890abcdef1234567890abcdef\",\n  \"version\": \"1.14.0\"\n}",
      "expectedUpstreamCommit": "deadbeef1234567890abcdef1234567890abcdef"
    }
  ],
  "invalidManifests": [
    {
      "input": {},
      "description": "missing upstreamCommit"
    },
    {
      "input": { "upstreamCommit": "" },
      "description": "empty upstreamCommit"
    },
    {
      "input": "invalid json {",
      "description": "malformed JSON string"
    }
  ],
  "pathVerificationCases": [
    {
      "runtimePath": "/mock/runtime",
      "existingFiles": [
        "/mock/runtime/surreal/surreal.exe",
        "/mock/runtime/backend/open_notebook",
        "/mock/runtime/frontend/server.js"
      ],
      "expectedValid": true,
      "expectedMissing": []
    },
    {
      "runtimePath": "/mock/runtime",
      "existingFiles": [
        "/mock/runtime/surreal/surreal.exe"
      ],
      "expectedValid": false,
      "expectedMissing": [
        "backend/open_notebook",
        "frontend/server.js"
      ]
    }
  ]
}
